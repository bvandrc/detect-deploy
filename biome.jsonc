{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.jsonc"],
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!conventions",
      // dist/ is a generated, minified bundle -- never ours to format or lint.
      "!**/dist",
      "!**/node_modules"
    ]
  }
}
