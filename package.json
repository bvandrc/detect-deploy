{
  "name": "poll-for-deploy",
  "version": "1.0.0",
  "private": true,
  "description": "Polls a URL until its content changes, to detect when a deploy has gone live.",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --minify",
    "typecheck": "tsc --noEmit",
    "all": "npm run typecheck && npm run build && npm test",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
