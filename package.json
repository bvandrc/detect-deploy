{
  "name": "detect-deploy",
  "version": "1.0.0",
  "private": true,
  "description": "Polls a URL until its content changes, to detect when a deploy has gone live.",
  "license": "ISC",
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "check": "biome check . && npm run ts:check",
    "format": "biome check . --fix",
    "ts:check": "tsc --noEmit",
    "__c2": "====================[ Testing ]==================================",
    "test": "node --experimental-strip-types --test test/*.test.mts"
  },
  "dependencies": {
    "@actions/cache": "^6",
    "@actions/core": "^1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^24",
    "esbuild": "^0.28",
    "typescript": "^7"
  }
}
